# =============================================================================
# Supabase
# Find these in: Supabase dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — admin grade, bypasses RLS. Required ONLY for the
# moderator-side review CLI (scripts/review/*.mjs, npm run comments:*).
# Never expose this in any code path that runs in the browser or in a
# Server Component / Route Handler.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# =============================================================================
# Site URL used by OAuth redirects.
# Local dev:   http://localhost:3000     (or 3001, 3002... if you change ports)
# Production:  https://your-domain.example
#
# This is read by the sign-in client as `${window.location.origin}/auth/callback`
# at runtime, so on localhost you usually don't need to set it. Set it
# explicitly only if your deploy runs behind a proxy that rewrites the host.
# =============================================================================
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# =============================================================================
# REQUIRED Supabase dashboard configuration for OAuth to work
# =============================================================================
#
# Supabase dashboard → Authentication → URL Configuration:
#
#   Site URL:
#     http://localhost:3000           (for dev)
#     OR your production URL (only one Site URL is allowed)
#
#   Redirect URLs (ALL of these — add them as separate entries):
#     http://localhost:3000/**
#     http://localhost:3000/auth/callback
#     https://your-prod-domain/**
#     https://your-prod-domain/auth/callback
#
# Supabase dashboard → Authentication → Providers → Google:
#   Enable + paste the Client ID & Client Secret from Google Cloud Console.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client:
#   Authorized redirect URIs:
#     https://<your-supabase-ref>.supabase.co/auth/v1/callback
#
# After changing any of the above, restart `next dev` so the new env values
# are picked up by the middleware.
