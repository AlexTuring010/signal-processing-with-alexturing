# Supabase
# Find these in: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — admin grade, bypasses RLS. Required ONLY for the
# moderator-side review CLI (scripts/review/*.mjs, npm run comments:*).
# Never expose this in any code path that runs in the browser or in a
# Server Component / Route Handler.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: site URL used in OAuth redirects (defaults to NEXT_PUBLIC_VERCEL_URL or localhost)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
