# =============================================================================
# Supabase
# Find these in: Supabase dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — admin grade, bypasses RLS. Required ONLY for the
# moderator-side review CLI (scripts/review/*.mjs, npm run comments:*).
# Never expose this in any code path that runs in the browser or in a
# Server Component / Route Handler.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# =============================================================================
# Site URL used by OAuth redirects.
#
# This is THE single source of truth for `redirectTo` in
# `supabase.auth.signInWithOAuth(...)`. Without it set in production,
# Supabase falls back to the dashboard "Site URL" — and if that is still
# `http://localhost:3000`, every production Google login bounces the user
# back to localhost.
#
# Local dev:   leave unset (the helper falls back to
#              NEXT_PUBLIC_VERCEL_URL → window.location.origin → localhost).
# Vercel:      set explicitly in Project → Environment Variables, for both
#              Production and Preview, e.g.:
#                NEXT_PUBLIC_SITE_URL=https://algorithms-class-hub.vercel.app
# Custom domain: set to the canonical https:// URL.
# =============================================================================
# NEXT_PUBLIC_SITE_URL=https://algorithms-class-hub.vercel.app

# =============================================================================
# REQUIRED Supabase dashboard configuration for OAuth to work
# =============================================================================
#
# Supabase dashboard → Authentication → URL Configuration:
#
#   Site URL:
#     https://algorithms-class-hub.vercel.app   ← set this to PRODUCTION,
#     not localhost. Only one Site URL is allowed; it's the fallback
#     destination when `redirectTo` is missing or rejected, so it MUST
#     match the production deploy or Google logins land on localhost.
#
#   Redirect URLs (add ALL of these as separate entries so localhost dev,
#   Vercel preview deploys, and production all work):
#     http://localhost:3000/**
#     http://localhost:3000/auth/callback
#     https://algorithms-class-hub.vercel.app/**
#     https://algorithms-class-hub.vercel.app/auth/callback
#     https://*-steliosrotas.vercel.app/**            ← preview deploys
#     https://*-steliosrotas.vercel.app/auth/callback ← preview deploys
#
# Supabase dashboard → Authentication → Providers → Google:
#   Enable + paste the Client ID & Client Secret from Google Cloud Console.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client:
#   Authorized JavaScript origins:
#     https://fcyowzsfhvuntdcisxzy.supabase.co
#   Authorized redirect URIs:
#     https://fcyowzsfhvuntdcisxzy.supabase.co/auth/v1/callback
#
# After changing any of the above, restart `next dev` (locally) or
# redeploy on Vercel so the new env values are picked up.
